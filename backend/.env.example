# Copy to backend/.env
# Load order: repo root `.env` (if present) then `backend/.env` — backend wins on duplicate keys.

# Postgres — required for API keys + protected routes when using the full stack
DATABASE_URL=postgresql+psycopg://rainuse:rainuse@localhost:5432/rainuse

# Must match collector/.env.local (NEXT_PUBLIC_AUTH0_DOMAIN / NEXT_PUBLIC_AUTH0_CLIENT_ID)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
# AUTH0_AUDIENCE=

# Optional — Earth Engine + Gemini (live CV / satellite chips)
# Leave ENABLE_LIVE_CV unset to auto-enable live when GEMINI_API_KEY + GEE_PROJECT_ID are both set.
# ENABLE_LIVE_CV=false forces mock only; ENABLE_LIVE_CV=true forces live allowed (still needs creds).
ENABLE_LIVE_CV=
GEE_PROJECT_ID=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
SAVE_GEE_THUMBNAILS=false
